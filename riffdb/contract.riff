      action_endpoint_id: action_endpoint_id,
      created_at_ms: created_at_ms,
      last_updated_at_ms: last_updated_at_ms,
      created_by: created_by,
      last_updated_by: last_updated_by,
    }
    overwrite guardrail.name = name
    overwrite guardrail.scorer_id = scorer_id
    overwrite guardrail.scorer_version = scorer_version
    overwrite guardrail.stage = stage
    overwrite guardrail.action = action
    overwrite guardrail.action_endpoint_id = action_endpoint_id
