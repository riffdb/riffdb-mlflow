contract RiffDBMLflow version 1 {
  enum LifecycleStage { Active, Deleted }
  enum RunStatus { Running, Scheduled, Finished, Failed, Killed }
  enum RunDataKind { Metric, LatestMetric, Param, Tag }
  enum ExperimentOrder {
    NameAscIdAsc,
    NameAscIdDesc,
    NameDescIdAsc,
    NameDescIdDesc,
    CreationAscIdAsc,
    CreationAscIdDesc,
    CreationDescIdAsc,
    CreationDescIdDesc,
    UpdateAscIdAsc,
    UpdateAscIdDesc,
    UpdateDescIdAsc,
    UpdateDescIdDesc,
    IdAsc,
    IdDesc
  }

  entity Experiment {
    key (scope: string<32>, experiment_id: u64)
    field name: string<500>
    field name_digest: bytes<32>
    field artifact_location: optional<string<8000>>
    field lifecycle_stage: LifecycleStage
    field creation_time: timestamp
    field last_update_time: timestamp
    field packed_tags: bytes<900000>
    field is_gateway: bool
    field revision: u64
    unique by_name (scope, name)
    index by_id (scope, experiment_id)
    index by_name_digest (scope, name_digest, experiment_id)
    index by_lifecycle_update (scope, lifecycle_stage, last_update_time, experiment_id)
    index by_update (scope, last_update_time, experiment_id)
    index by_creation (scope, creation_time, experiment_id)
    pattern_index by_name_binary_pattern(
      name,
      profile binary_utf8_v1,
      operators (equals, starts_with, ends_with, contains, like, not_like),
      max_source_bytes 500,
      max_matched_bytes 500,
      max_rows 16384,
      max_total_matched_bytes 268435456,
      max_grams_per_row 500,
      max_distinct_grams 65535,
      max_postings 1048576,
      max_postings_bytes 67108864,
      max_pattern_bytes 500,
      max_pattern_atoms 500,
      max_candidates 16384,
      max_verification_bytes 268435456,
      max_results 16383,
      staleness_slo 60,
      replay_age_seconds 86400,
      replay_bytes 1073741824,
      replay_backlog 100000,
      retained_generations 8
    )
    pattern_index by_name_folded_pattern(
      name,
      profile unicode_fold_v1,
      operators (equals, starts_with, ends_with, contains, like, ilike, not_like, not_ilike),
      max_source_bytes 500,
      max_matched_bytes 9000,
      max_rows 16384,
      max_total_matched_bytes 268435456,
      max_grams_per_row 500,
      max_distinct_grams 65535,
      max_postings 1048576,
      max_postings_bytes 67108864,
      max_pattern_bytes 500,
      max_pattern_atoms 500,
      max_candidates 16384,
      max_verification_bytes 268435456,
      max_results 16383,
      staleness_slo 60,
      replay_age_seconds 86400,
      replay_bytes 1073741824,
      replay_backlog 100000,
      retained_generations 8
    )
  }

  entity ExperimentTag {
    key (scope: string<32>, experiment_id: u64, tag_key: string<250>)
    field value: string<5000>
    field value_digest: bytes<32>
    field value_hash: u64
    index by_tag_key (scope, tag_key, experiment_id)
    index by_tag_digest (scope, tag_key, value_digest, experiment_id)
    index by_tag_hash (scope, tag_key, value_hash, experiment_id)
    pattern_index by_value_binary_pattern(
      value,
      profile binary_utf8_v1,
      operators (equals, starts_with, ends_with, contains, like, not_like),
      max_source_bytes 5000,
      max_matched_bytes 5000,
      max_rows 16384,
      max_total_matched_bytes 268435456,
      max_grams_per_row 5000,
      max_distinct_grams 65535,
      max_postings 1048576,
      max_postings_bytes 67108864,
      max_pattern_bytes 5000,
      max_pattern_atoms 5000,
      max_candidates 16384,
      max_verification_bytes 268435456,
      max_results 16383,
      staleness_slo 60,
      replay_age_seconds 86400,
      replay_bytes 1073741824,
      replay_backlog 100000,
      retained_generations 8
    )
    pattern_index by_value_folded_pattern(
      value,
      profile unicode_fold_v1,
      operators (equals, starts_with, ends_with, contains, like, ilike, not_like, not_ilike),
      max_source_bytes 5000,
      max_matched_bytes 90000,
      max_rows 16384,
      max_total_matched_bytes 268435456,
      max_grams_per_row 5000,
      max_distinct_grams 65535,
      max_postings 1048576,
      max_postings_bytes 67108864,
      max_pattern_bytes 5000,
      max_pattern_atoms 5000,
      max_candidates 16384,
      max_verification_bytes 268435456,
      max_results 16383,
      staleness_slo 60,
      replay_age_seconds 86400,
      replay_bytes 1073741824,
      replay_backlog 100000,
      retained_generations 8
    )
    reference experiment (scope, experiment_id) -> Experiment(scope, experiment_id)
    delete_policy no_inbound
  }

  entity Run {
    key (experiment_id: u64, run_id: string<32>)
    field user_id: string<256>
    field status: RunStatus
    field start_time: i64
    field end_time: optional<i64>
    field lifecycle_stage: LifecycleStage
    field artifact_uri: string<8000>
    field run_name: string<250>
    field packed_tags: bytes<900000>
    field packed_params: bytes<700000>
    field packed_latest_metrics: bytes<400000>
    field revision: u64
    field initialized: bool
    index by_start (experiment_id, start_time, run_id)
    index by_lifecycle_start (experiment_id, lifecycle_stage, start_time, run_id)
    index by_name (experiment_id, run_name, run_id)
    index by_status (experiment_id, status, run_id)
  }

  entity RunDatum {
    key (
      experiment_id: u64,
      run_id: string<32>,
      kind: RunDataKind,
      item_key: string<283>,
      entry_id: string<64>
    )
    field logical_key: string<250>
    field latest_item_key: string<283>
    field sort_key: string<64>
    field latest_sort_key: string<64>
    field text_value: string<8000>
    field value_digest: bytes<32>
    field value_bits: u64
    field value_identity: u64
    field value_order: u64
    field metric_timestamp: i64
    field metric_step: i64
    field is_nan: bool
    field promote_latest: bool
    index by_run_data (
      experiment_id, kind, item_key, value_digest, sort_key, run_id, entry_id
    ) cover(logical_key, value_bits, metric_timestamp, metric_step, is_nan)
    reference run (experiment_id, run_id) -> Run(experiment_id, run_id)
    delete_policy no_inbound
  }

  entity RunLineage {
    key (experiment_id: u64, run_id: string<32>)
    field packed_datasets: bytes<200000>
    field packed_model_inputs: bytes<100000>
    field packed_model_outputs: bytes<100000>
    reference run (experiment_id, run_id) -> Run(experiment_id, run_id)
    delete_policy no_inbound
  }

  entity Trace {
    key (experiment_id: u64, trace_id: string<64>)
    field request_time_ms: i64
    field execution_duration_ms: i64
    field state: string<32>
    field status_code: string<32>
    field trace_name: string<256>
    field client_request_id: optional<string<128>>
    field request_preview: optional<string<2000>>
    field response_preview: optional<string<2000>>
    field source_run_id: optional<string<32>>
    field span_count: i64
    field error_span_count: i64
    field total_input_tokens: i64
    field total_output_tokens: i64
    field total_tokens: i64
    field cache_read_input_tokens: i64
    field cache_creation_input_tokens: i64
    field total_cost_micros: i64
    field session_id: optional<string<128>>
    field packed_trace_metadata: bytes<16384>
    field packed_tags: bytes<16384>
    field packed_run_ids: bytes<16384>
    field packed_prompt_versions: bytes<16384>
    field requested_at: timestamp
    field initialized: bool
    index by_id (experiment_id, trace_id)
    index by_request_time (experiment_id, request_time_ms, trace_id)
    index by_state_time (experiment_id, state, request_time_ms, trace_id)
    delete_policy no_inbound
  }

  entity TraceSpan {
    key (experiment_id: u64, trace_id: string<64>, span_id: string<64>)
    field parent_id: optional<string<64>>
    field name: string<256>
    field span_type: string<64>
    field status: string<32>
    field start_time_ns: i64
    field end_time_ns: i64
    field duration_ms: i64
    field model_name: string<128>
    field model_provider: string<64>
    field input_tokens: i64
    field output_tokens: i64
    field total_tokens: i64
    field input_cost_micros: i64
    field output_cost_micros: i64
    field total_cost_micros: i64
    field started_at: timestamp
    field packed_span_json: string<7000>
    index by_trace_start (experiment_id, trace_id, start_time_ns, span_id) cover (packed_span_json)
    index by_exp_start (experiment_id, start_time_ns, trace_id, span_id)
    delete_policy no_inbound
  }

  entity TraceAssessment {
    key (experiment_id: u64, trace_id: string<64>, assessment_id: string<64>)
    field name: string<250>
    field assessment_type: string<32>
    field value_text: string<2000>
    field numeric_value_milli: optional<i64>
    field created_timestamp_ms: i64
    field last_updated_timestamp_ms: i64
    field span_id: optional<string<64>>
    field packed_assessment_json: string<7000>
    index by_trace_created (experiment_id, trace_id, created_timestamp_ms, assessment_id) cover (assessment_type, last_updated_timestamp_ms, packed_assessment_json)
    index by_exp_created (experiment_id, created_timestamp_ms, trace_id, assessment_id)
    delete_policy no_inbound
  }

  entity LoggedModelEntity {
    key (experiment_id: u64, model_id: string<64>)
    field name: string<500>
    field artifact_location: string<8000>
    field creation_timestamp_ms: i64
    field last_updated_timestamp_ms: i64
    field status: string<32>
    field lifecycle_stage: LifecycleStage
    field status_message: optional<string<1000>>
    field source_run_id: optional<string<32>>
    field model_type: optional<string<250>>
    field packed_tags: bytes<16384>
    field packed_params: bytes<16384>
    field packed_metrics: bytes<16384>
    index by_creation (experiment_id, creation_timestamp_ms, model_id)
    index by_status (experiment_id, status, creation_timestamp_ms, model_id)
    delete_policy no_inbound
  }

  entity RegisteredModelEntity {
    key (scope: string<32>, name: string<256>)
    field creation_timestamp_ms: i64
    field last_updated_timestamp_ms: i64
    field description: optional<string<5000>>
    field packed_tags: bytes<65536>
    field packed_aliases: bytes<16384>
    field latest_version: u64
    index by_name (scope, name)
    index by_update (scope, last_updated_timestamp_ms, name)
    delete_policy no_inbound
  }

  entity ModelVersionEntity {
    key (scope: string<32>, name: string<256>, version_num: u64)
    field creation_timestamp_ms: i64
    field last_updated_timestamp_ms: i64
    field description: optional<string<5000>>
    field user_id: optional<string<256>>
    field current_stage: string<32>
    field source_path: string<2000>
    field storage_location: string<2000>
    field run_id: optional<string<32>>
    field run_link: optional<string<2000>>
    field status: string<32>
    field status_message: optional<string<500>>
    field packed_tags: bytes<65536>
    index by_model_version (scope, name, version_num)
    index by_update (scope, last_updated_timestamp_ms, name, version_num)
    delete_policy no_inbound
  }

  entity RegistryWebhookEntity {
    key (scope: string<32>, webhook_id: string<64>)
    field name: string<256>
    field description: optional<string<1000>>
    field url: string<2000>
    field status: string<32>
    field secret: optional<string<1000>>
    field packed_events: bytes<4096>
    field creation_timestamp_ms: i64
    field last_updated_timestamp_ms: i64
    field deleted_timestamp_ms: optional<i64>
    index by_creation (scope, creation_timestamp_ms, webhook_id)
    delete_policy no_inbound
  }

  entity MCPServerEntity {
    key (scope: string<32>, name: string<256>)
    field display_name: optional<string<256>>
    field description: optional<string<5000>>
    field packed_icons: bytes<16384>
    field packed_tags: bytes<16384>
    field packed_aliases: bytes<16384>
    field created_by: optional<string<256>>
    field last_updated_by: optional<string<256>>
    field created_at_ms: i64
    field last_updated_at_ms: i64
    index by_name (scope, name)
    index by_created (scope, created_at_ms, name)
    index by_updated (scope, last_updated_at_ms, name)
    delete_policy no_inbound
  }

  entity MCPServerVersionEntity {
    key (scope: string<32>, name: string<256>, server_version: string<128>)
    field version_major: i64
    field version_minor: i64
    field version_patch: i64
    field version_prerelease_sort_key: string<256>
    field server_json: string<65536>
    field status: string<32>
    field packed_tools: bytes<65536>
    field packed_tags: bytes<16384>
    field packed_connect_options: bytes<16384>
    field source_url: optional<string<2000>>
    field created_by: optional<string<256>>
    field last_updated_by: optional<string<256>>
    field created_at_ms: i64
    field last_updated_at_ms: i64
    index by_server_created (scope, name, created_at_ms, server_version)
    index by_all_created (scope, created_at_ms, name, server_version)
    delete_policy no_inbound
  }

  entity MCPAccessEndpointEntity {
    key (scope: string<32>, endpoint_id: string<64>)
    field server_name: string<256>
    field url: string<2000>
    field transport_type: string<64>
    field server_version: optional<string<128>>
    field server_alias: optional<string<128>>
    field created_by: optional<string<256>>
    field last_updated_by: optional<string<256>>
    field created_at_ms: i64
    field last_updated_at_ms: i64
    index by_id (scope, endpoint_id)
    index by_server_id (scope, server_name, endpoint_id)
    delete_policy no_inbound
  }

  entity GatewaySecretEntity {
    key (scope: string<32>, secret_id: string<64>)
    field secret_name: string<256>
    field encrypted_value: bytes<32768>
    field wrapped_dek: bytes<4096>
    field masked_value_json: string<4096>
    field kek_version: i64
    field provider: optional<string<128>>
    field auth_config_json: optional<string<8192>>
    field created_at_ms: i64
    field last_updated_at_ms: i64
    field created_by: optional<string<256>>
    field last_updated_by: optional<string<256>>
    index by_id (scope, secret_id)
    delete_policy no_inbound
  }

  entity GatewayModelDefinitionEntity {
    key (scope: string<32>, model_definition_id: string<64>)
    field name: string<256>
    field secret_id: optional<string<64>>
    field provider: string<128>
    field model_name: string<256>
    field created_at_ms: i64
    field last_updated_at_ms: i64
    field created_by: optional<string<256>>
    field last_updated_by: optional<string<256>>
    index by_id (scope, model_definition_id)
    delete_policy no_inbound
  }

  entity GatewayEndpointEntity {
    key (scope: string<32>, endpoint_id: string<64>)
    field name: string<256>
    field routing_strategy: optional<string<64>>
    field fallback_config_json: optional<string<8192>>
    field experiment_id: optional<u64>
    field usage_tracking: bool
    field packed_model_mappings: bytes<32768>
    field packed_tags: bytes<16384>
    field packed_bindings: bytes<16384>
    field packed_guardrail_configs: bytes<16384>
    field created_at_ms: i64
    field last_updated_at_ms: i64
    field created_by: optional<string<256>>
    field last_updated_by: optional<string<256>>
    index by_id (scope, endpoint_id)
    delete_policy no_inbound
  }

  entity GatewayBudgetPolicyEntity {
    key (scope: string<32>, budget_policy_id: string<64>)
    field budget_unit: string<64>
    field budget_amount_json: string<128>
    field duration_unit: string<64>
    field duration_value: i64
    field target_scope: string<64>
    field target_value: optional<string<256>>
    field budget_action: string<64>
    field created_at_ms: i64
    field last_updated_at_ms: i64
    field created_by: optional<string<256>>
    field last_updated_by: optional<string<256>>
    index by_id (scope, budget_policy_id)
    delete_policy no_inbound
  }

  entity GatewayGuardrailEntity {
    key (scope: string<32>, guardrail_id: string<64>)
    field name: string<256>
    field scorer_id: string<64>
    field scorer_version: i64
    field stage: string<64>
    field action: string<64>
    field action_endpoint_id: optional<string<64>>
    field created_at_ms: i64
    field last_updated_at_ms: i64
    field created_by: optional<string<256>>
    field last_updated_by: optional<string<256>>
    index by_id (scope, guardrail_id)
    delete_policy no_inbound
  }

  entity ScorerEntity {
    key (scope: string<32>, scorer_id: string<64>)
    field experiment_id: u64
    field scorer_name: string<256>
    field latest_version: i64
    field packed_versions: bytes<65536>
    field packed_online_config: bytes<8192>
    index by_id (scope, scorer_id)
    index by_experiment (scope, experiment_id, scorer_id)
    delete_policy no_inbound
  }

  entity ServerJobEntity {
    key (scope: string<32>, job_id: string<64>)
    field creation_time_ms: i64
    field job_name: string<256>
    field params_json: string<16384>
    field timeout_json: optional<string<128>>
    field status_code: i64
    field result_text: optional<string<32768>>
    field retry_count: i64
    field last_update_time_ms: i64
    field status_details_json: optional<string<16384>>
    index by_creation (scope, creation_time_ms, job_id)
    delete_policy no_inbound
  }

  event SpanObserved {
    experiment_id: u64
    span_type: string<64>
    model_name: string<128>
    status: string<32>
    duration_ms: i64
    input_tokens: i64
    output_tokens: i64
    total_tokens: i64
    cost_micros: i64
    observed_at: timestamp
  }

  projection SpanModelRollup {
    source event SpanObserved
    key (experiment_id, span_type, model_name, status, hour(observed_at))
    measure span_count = count()
    measure total_duration_ms = sum(duration_ms)
    measure min_duration_ms = min(duration_ms)
    measure max_duration_ms = max(duration_ms)
    measure avg_duration_ms = mean(duration_ms)
    measure sum_input_tokens = sum(input_tokens)
    measure sum_output_tokens = sum(output_tokens)
    measure sum_total_tokens = sum(total_tokens)
    measure sum_cost_micros = sum(cost_micros)
    frontier transactionally_ordered
  }

  columnar_projection TraceAnalytics {
    source entity Trace
    fields (
      request_time_ms,
      execution_duration_ms,
      state,
      status_code,
      trace_name,
      span_count,
      error_span_count,
      total_input_tokens,
      total_output_tokens,
      total_tokens,
      cache_read_input_tokens,
      cache_creation_input_tokens,
      total_cost_micros,
      session_id,
      requested_at
    )
  }

  columnar_projection SpanAnalytics {
    source entity TraceSpan
    fields (
      name,
      span_type,
      status,
      start_time_ns,
      end_time_ns,
      duration_ms,
      model_name,
      model_provider,
      input_tokens,
      output_tokens,
      total_tokens,
      input_cost_micros,
      output_cost_micros,
      total_cost_micros,
      started_at
    )
  }

  columnar_projection AssessmentAnalytics {
    source entity TraceAssessment
    fields (
      name,
      assessment_type,
      value_text,
      numeric_value_milli,
      created_timestamp_ms
    )
  }

  aggregate Experiments {
    root Experiment
    child ExperimentTag
    partition_by scope
    conflict_key (scope, experiment_id)
  }

  aggregate Runs {
    root Run
    child RunDatum
    child RunLineage
    partition_by experiment_id
    conflict_key (experiment_id, run_id)
  }

  aggregate Traces {
    root Trace
    child TraceSpan
    child TraceAssessment
    partition_by experiment_id
    conflict_key (experiment_id, trace_id)
  }

  aggregate LoggedModels {
    root LoggedModelEntity
    partition_by experiment_id
    conflict_key (experiment_id, model_id)
  }

  aggregate RegisteredModels {
    root RegisteredModelEntity
    child ModelVersionEntity
    partition_by scope
    conflict_key (scope, name)
  }

  aggregate RegistryWebhooks {
    root RegistryWebhookEntity
    partition_by scope
    conflict_key (scope, webhook_id)
  }

  aggregate MCPServers {
    root MCPServerEntity
    child MCPServerVersionEntity
    partition_by scope
    conflict_key (scope, name)
  }

  aggregate MCPAccessEndpoints {
    root MCPAccessEndpointEntity
    partition_by scope
    conflict_key (scope, endpoint_id)
  }

  aggregate GatewaySecrets {
    root GatewaySecretEntity
    partition_by scope
    conflict_key (scope, secret_id)
  }

  aggregate GatewayModelDefinitions {
    root GatewayModelDefinitionEntity
    partition_by scope
    conflict_key (scope, model_definition_id)
  }

  aggregate GatewayEndpoints {
    root GatewayEndpointEntity
    partition_by scope
    conflict_key (scope, endpoint_id)
  }

  aggregate GatewayBudgetPolicies {
    root GatewayBudgetPolicyEntity
    partition_by scope
    conflict_key (scope, budget_policy_id)
  }

  aggregate GatewayGuardrails {
    root GatewayGuardrailEntity
    partition_by scope
    conflict_key (scope, guardrail_id)
  }

  aggregate Scorers {
    root ScorerEntity
    partition_by scope
    conflict_key (scope, scorer_id)
  }

  aggregate ServerJobs {
    root ServerJobEntity
    partition_by scope
    conflict_key (scope, job_id)
  }

  command CreateExperiment {
    input request_id: string<128>
    input experiment_id: u64
    input name: string<500>
    input name_digest: bytes<32>
    input artifact_location: optional<string<8000>>
    input packed_tags: bytes<900000>
    input is_gateway: bool
    service now: transaction_time
    idempotency_key request_id
    create Experiment("global", experiment_id) as experiment else ExperimentExists {}
    set experiment.name = name
    set experiment.name_digest = name_digest
    set experiment.artifact_location = artifact_location
    set experiment.lifecycle_stage = LifecycleStage.Active
    set experiment.creation_time = now
    set experiment.last_update_time = now
    set experiment.packed_tags = packed_tags
    set experiment.is_gateway = is_gateway
    set experiment.revision = 0
    return ExperimentCreated { experiment: experiment }
  }

  bulk command CreateExperimentWithTags {
    input request_id: string<128>
    input experiment_id: u64
    input name: string<500>
    input name_digest: bytes<32>
    input artifact_location: optional<string<8000>>
    input packed_tags: bytes<900000>
    input is_gateway: bool
    input tags: list<ExperimentTag, 1..128> aggregate_bytes <= 900000
    service now: transaction_time
    idempotency_key request_id
    create Experiment("global", experiment_id) as experiment else ExperimentExists {}
    for candidate in tags {
      create ExperimentTag("global", experiment_id, candidate.tag_key) as tag
        else ExperimentTagExists {}
      set tag.value = candidate.value
      set tag.value_digest = candidate.value_digest
      set tag.value_hash = candidate.value_hash
    }
    set experiment.name = name
    set experiment.name_digest = name_digest
    set experiment.artifact_location = artifact_location
    set experiment.lifecycle_stage = LifecycleStage.Active
    set experiment.creation_time = now
    set experiment.last_update_time = now
    set experiment.packed_tags = packed_tags
    set experiment.is_gateway = is_gateway
    set experiment.revision = 0
    return ExperimentCreated { experiment: experiment }
  }

  command RenameExperiment {
    input request_id: string<128>
    input experiment_id: u64
    input name: string<500>
    input name_digest: bytes<32>
    service now: transaction_time
    idempotency_key request_id
    mutate Experiment("global", experiment_id) as experiment else ExperimentMissing {}
    overwrite experiment.name = name
    overwrite experiment.name_digest = name_digest
    overwrite experiment.last_update_time = now
    set experiment.revision = experiment.revision + 1
    return ExperimentRenamed { experiment: experiment }
  }

  command DeleteExperiment {
    input request_id: string<128>
    input experiment_id: u64
    service now: transaction_time
    idempotency_key request_id
    mutate Experiment("global", experiment_id) as experiment else ExperimentMissing {}
    overwrite experiment.lifecycle_stage = LifecycleStage.Deleted
    overwrite experiment.last_update_time = now
    set experiment.revision = experiment.revision + 1
    return ExperimentDeleted { experiment: experiment }
  }

  command RestoreExperiment {
    input request_id: string<128>
    input experiment_id: u64
    service now: transaction_time
    idempotency_key request_id
    mutate Experiment("global", experiment_id) as experiment else ExperimentMissing {}
    overwrite experiment.lifecycle_stage = LifecycleStage.Active
    overwrite experiment.last_update_time = now
    set experiment.revision = experiment.revision + 1
    return ExperimentRestored { experiment: experiment }
  }

  command SetExperimentTag {
    input request_id: string<128>
    input experiment_id: u64
    input tag_key: string<250>
    input value: string<5000>
    input value_digest: bytes<32>
    input value_hash: u64
    input packed_tags: bytes<900000>
    input is_gateway: bool
    input expected_revision: u64
    service now: transaction_time
    idempotency_key request_id
    mutate Experiment("global", experiment_id) as experiment else ExperimentMissing {}
    init_or_mutate ExperimentTag("global", experiment_id, tag_key) as tag initialize {
      value: value,
      value_digest: value_digest,
      value_hash: value_hash,
    }
    require current_revision: experiment.revision == expected_revision else ExperimentStale {}
    require active: experiment.lifecycle_stage == LifecycleStage.Active else ExperimentInactive {}
    set tag.value = value
    set tag.value_digest = value_digest
    set tag.value_hash = value_hash
    set experiment.packed_tags = packed_tags
    set experiment.is_gateway = is_gateway
    set experiment.last_update_time = now
    set experiment.revision = experiment.revision + 1
    return ExperimentTagSet { experiment: experiment }
  }

  command DeleteExperimentTag {
    input request_id: string<128>
    input experiment_id: u64
    input tag_key: string<250>
    input packed_tags: bytes<900000>
    input is_gateway: bool
    input expected_revision: u64
    service now: transaction_time
    idempotency_key request_id
    mutate Experiment("global", experiment_id) as experiment else ExperimentMissing {}
    delete ExperimentTag("global", experiment_id, tag_key) as tag else ExperimentTagMissing {}
    require current_revision: experiment.revision == expected_revision else ExperimentStale {}
    require active: experiment.lifecycle_stage == LifecycleStage.Active else ExperimentInactive {}
    set experiment.packed_tags = packed_tags
    set experiment.is_gateway = is_gateway
    set experiment.last_update_time = now
    set experiment.revision = experiment.revision + 1
    return ExperimentTagDeleted { experiment: experiment }
  }

  command CreateRun {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    input user_id: string<256>
    input start_time: i64
    input artifact_uri: string<8000>
    input run_name: string<250>
    input packed_tags: bytes<900000>
    input packed_params: bytes<700000>
    input packed_latest_metrics: bytes<400000>
    idempotency_key request_id
    create Run(experiment_id, run_id) as run else RunExists {}
    set run.user_id = user_id
    set run.status = RunStatus.Running
    set run.start_time = start_time
    set run.end_time = null
    set run.lifecycle_stage = LifecycleStage.Active
    set run.artifact_uri = artifact_uri
    set run.run_name = run_name
    set run.packed_tags = packed_tags
    set run.packed_params = packed_params
    set run.packed_latest_metrics = packed_latest_metrics
    set run.revision = 0
    set run.initialized = true
    return RunCreated { run: run }
  }

  bulk command CreateRunWithTags {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    input user_id: string<256>
    input start_time: i64
    input artifact_uri: string<8000>
    input run_name: string<250>
    input packed_tags: bytes<900000>
    input packed_params: bytes<700000>
    input packed_latest_metrics: bytes<400000>
    input tags: list<RunDatum, 1..100> aggregate_bytes <= 900000
    idempotency_key request_id
    create Run(experiment_id, run_id) as run else RunExists {}
    for candidate in tags {
      create RunDatum(
        experiment_id,
        run_id,
        RunDataKind.Tag,
        candidate.item_key,
        ""
      ) as tag else RunTagExists {}
      set tag.logical_key = candidate.logical_key
      set tag.latest_item_key = candidate.latest_item_key
      set tag.sort_key = candidate.sort_key
      set tag.latest_sort_key = candidate.latest_sort_key
      set tag.text_value = candidate.text_value
      set tag.value_digest = candidate.value_digest
      set tag.value_bits = 0
      set tag.value_identity = 0
      set tag.value_order = 0
      set tag.metric_timestamp = 0
      set tag.metric_step = 0
      set tag.is_nan = false
      set tag.promote_latest = false
    }
    set run.user_id = user_id
    set run.status = RunStatus.Running
    set run.start_time = start_time
    set run.end_time = null
    set run.lifecycle_stage = LifecycleStage.Active
    set run.artifact_uri = artifact_uri
    set run.run_name = run_name
    set run.packed_tags = packed_tags
    set run.packed_params = packed_params
    set run.packed_latest_metrics = packed_latest_metrics
    set run.revision = 0
    set run.initialized = true
    return RunCreated { run: run }
  }

  command UpdateRunInfo {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    input status: RunStatus
    input end_time: optional<i64>
    input run_name: string<250>
    input run_name_tag_value: string<8000>
    input run_name_digest: bytes<32>
    input packed_tags: bytes<900000>
    input expected_revision: u64
    idempotency_key request_id
    mutate Run(experiment_id, run_id) as run else RunMissing {}
    init_or_mutate RunDatum(
      experiment_id,
      run_id,
      RunDataKind.Tag,
      "mlflow.runName",
      ""
    ) as run_name_tag initialize {
      logical_key: "mlflow.runName",
      latest_item_key: "mlflow.runName",
      sort_key: "",
      latest_sort_key: "",
      text_value: run_name_tag_value,
      value_digest: run_name_digest,
      value_bits: 0,
      value_identity: 0,
      value_order: 0,
      metric_timestamp: 0,
      metric_step: 0,
      is_nan: false,
      promote_latest: false,
    }
    require current_revision: run.revision == expected_revision else RunStale {}
    require active: run.lifecycle_stage == LifecycleStage.Active else RunInactive {}
    set run_name_tag.text_value = run_name_tag_value
    set run_name_tag.value_digest = run_name_digest
    set run.status = status
    set run.end_time = end_time
    set run.run_name = run_name
    set run.packed_tags = packed_tags
    set run.revision = run.revision + 1
    return RunUpdated { run: run }
  }

  bulk command LogBatch {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    input expected_revision: u64
    input packed_tags: bytes<900000>
    input packed_params: bytes<700000>
    input packed_latest_metrics: bytes<400000>
    input items: list<RunDatum, 1..1000> aggregate_bytes <= 1000000
    idempotency_key request_id
    observe_or_initialize Run(experiment_id, run_id) as run initialize {
      user_id: "",
      status: RunStatus.Running,
      start_time: 0,
      end_time: null,
      lifecycle_stage: LifecycleStage.Deleted,
      artifact_uri: "",
      run_name: "",
      packed_tags: packed_tags,
      packed_params: packed_params,
      packed_latest_metrics: packed_latest_metrics,
      revision: 0,
      initialized: false,
    }
    decide run {
      when run.initialized == false => reject RunMissing {}
      when run.revision != expected_revision => reject RunStale {}
      when run.lifecycle_stage != LifecycleStage.Active => reject RunInactive {}
      else => apply {
        overwrite run.packed_tags = packed_tags
        overwrite run.packed_params = packed_params
        overwrite run.packed_latest_metrics = packed_latest_metrics
        set run.revision = run.revision + 1
        overwrite run.initialized = true
      }
    }
    for candidate in items {
      observe_or_initialize RunDatum(
        experiment_id,
        run_id,
        candidate.kind,
        candidate.item_key,
        candidate.entry_id
      ) as stored initialize {
        logical_key: candidate.logical_key,
        latest_item_key: candidate.latest_item_key,
        sort_key: candidate.sort_key,
        latest_sort_key: candidate.latest_sort_key,
        text_value: candidate.text_value,
        value_digest: candidate.value_digest,
        value_bits: candidate.value_bits,
        value_identity: candidate.value_identity,
        value_order: candidate.value_order,
        metric_timestamp: candidate.metric_timestamp,
        metric_step: candidate.metric_step,
        is_nan: candidate.is_nan,
        promote_latest: candidate.promote_latest,
      }
      decide stored {
        when candidate.kind == RunDataKind.Param
          && stored.text_value != candidate.text_value
          => reject ParamConflict { param_key: candidate.logical_key }
        when candidate.kind == RunDataKind.Metric
          && candidate.promote_latest == true
          => apply {
            init_or_mutate RunDatum(
              experiment_id,
              run_id,
              RunDataKind.LatestMetric,
              candidate.latest_item_key,
              ""
            ) as latest initialize {
              logical_key: candidate.logical_key,
              latest_item_key: candidate.latest_item_key,
              sort_key: candidate.latest_sort_key,
              latest_sort_key: candidate.latest_sort_key,
              text_value: "",
              value_digest: candidate.value_digest,
              value_bits: candidate.value_bits,
              value_identity: candidate.value_identity,
              value_order: candidate.value_order,
              metric_timestamp: candidate.metric_timestamp,
              metric_step: candidate.metric_step,
              is_nan: candidate.is_nan,
              promote_latest: false,
            }
            overwrite stored.text_value = candidate.text_value
            overwrite stored.logical_key = candidate.logical_key
            overwrite stored.latest_item_key = candidate.latest_item_key
            overwrite stored.sort_key = candidate.sort_key
            overwrite stored.latest_sort_key = candidate.latest_sort_key
            overwrite stored.value_digest = candidate.value_digest
            overwrite stored.value_bits = candidate.value_bits
            overwrite stored.value_identity = candidate.value_identity
            overwrite stored.value_order = candidate.value_order
            overwrite stored.metric_timestamp = candidate.metric_timestamp
            overwrite stored.metric_step = candidate.metric_step
            overwrite stored.is_nan = candidate.is_nan
            overwrite stored.promote_latest = false
            overwrite latest.text_value = ""
            overwrite latest.logical_key = candidate.logical_key
            overwrite latest.latest_item_key = candidate.latest_item_key
            overwrite latest.sort_key = candidate.latest_sort_key
            overwrite latest.latest_sort_key = candidate.latest_sort_key
            overwrite latest.value_digest = candidate.value_digest
            overwrite latest.value_bits = candidate.value_bits
            overwrite latest.value_identity = candidate.value_identity
            overwrite latest.value_order = candidate.value_order
            overwrite latest.metric_timestamp = candidate.metric_timestamp
            overwrite latest.metric_step = candidate.metric_step
            overwrite latest.is_nan = candidate.is_nan
            overwrite latest.promote_latest = false
        }
        else => apply {
          overwrite stored.logical_key = candidate.logical_key
          overwrite stored.latest_item_key = candidate.latest_item_key
          overwrite stored.sort_key = candidate.sort_key
          overwrite stored.latest_sort_key = candidate.latest_sort_key
          overwrite stored.text_value = candidate.text_value
          overwrite stored.value_digest = candidate.value_digest
          overwrite stored.value_bits = candidate.value_bits
          overwrite stored.value_identity = candidate.value_identity
          overwrite stored.value_order = candidate.value_order
          overwrite stored.metric_timestamp = candidate.metric_timestamp
          overwrite stored.metric_step = candidate.metric_step
          overwrite stored.is_nan = candidate.is_nan
          overwrite stored.promote_latest = false
        }
      }
    }
    return BatchLogged { run: run }
  }

  command ValidateRunActive {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    idempotency_key request_id
    read Run(experiment_id, run_id) as run else RunMissing {}
    require active: run.lifecycle_stage == LifecycleStage.Active else RunInactive {}
    return RunActive {}
  }

  command DeleteRun {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    idempotency_key request_id
    mutate Run(experiment_id, run_id) as run else RunMissing {}
    overwrite run.lifecycle_stage = LifecycleStage.Deleted
    set run.revision = run.revision + 1
    return RunDeleted { run: run }
  }

  command RestoreRun {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    idempotency_key request_id
    mutate Run(experiment_id, run_id) as run else RunMissing {}
    overwrite run.lifecycle_stage = LifecycleStage.Active
    set run.revision = run.revision + 1
    return RunRestored { run: run }
  }

  command UpsertRunLineage {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    input packed_datasets: bytes<200000>
    input packed_model_inputs: bytes<100000>
    input packed_model_outputs: bytes<100000>
    idempotency_key request_id
    read Run(experiment_id, run_id) as run else RunMissing {}
    init_or_mutate RunLineage(experiment_id, run_id) as lineage initialize {
      packed_datasets: packed_datasets,
      packed_model_inputs: packed_model_inputs,
      packed_model_outputs: packed_model_outputs,
    }
    require active: run.lifecycle_stage == LifecycleStage.Active else RunInactive {}
    overwrite lineage.packed_datasets = packed_datasets
    overwrite lineage.packed_model_inputs = packed_model_inputs
    overwrite lineage.packed_model_outputs = packed_model_outputs
    return RunLineageUpserted { lineage: lineage }
  }

  command UpsertTrace {
    input request_id: string<128>
    input experiment_id: u64
    input trace_id: string<64>
    input request_time_ms: i64
    input execution_duration_ms: i64
    input state: string<32>
    input status_code: string<32>
    input trace_name: string<256>
    input client_request_id: optional<string<128>>
    input request_preview: optional<string<2000>>
    input response_preview: optional<string<2000>>
    input source_run_id: optional<string<32>>
    input span_count: i64
    input error_span_count: i64
    input total_input_tokens: i64
    input total_output_tokens: i64
    input total_tokens: i64
    input cache_read_input_tokens: i64
    input cache_creation_input_tokens: i64
    input total_cost_micros: i64
    input session_id: optional<string<128>>
    input packed_trace_metadata: bytes<16384>
    input packed_tags: bytes<16384>
    input packed_run_ids: bytes<16384>
    input packed_prompt_versions: bytes<16384>
    input requested_at: timestamp
    input initialized: bool
    idempotency_key request_id
    init_or_mutate Trace(experiment_id, trace_id) as trace initialize {
      request_time_ms: request_time_ms,
      execution_duration_ms: execution_duration_ms,
      state: state,
      status_code: status_code,
      trace_name: trace_name,
      client_request_id: client_request_id,
      request_preview: request_preview,
      response_preview: response_preview,
      source_run_id: source_run_id,
      span_count: span_count,
      error_span_count: error_span_count,
      total_input_tokens: total_input_tokens,
      total_output_tokens: total_output_tokens,
      total_tokens: total_tokens,
      cache_read_input_tokens: cache_read_input_tokens,
      cache_creation_input_tokens: cache_creation_input_tokens,
      total_cost_micros: total_cost_micros,
      session_id: session_id,
      packed_trace_metadata: packed_trace_metadata,
      packed_tags: packed_tags,
      packed_run_ids: packed_run_ids,
      packed_prompt_versions: packed_prompt_versions,
      requested_at: requested_at,
      initialized: initialized,
    }
    overwrite trace.request_time_ms = request_time_ms
    overwrite trace.execution_duration_ms = execution_duration_ms
    overwrite trace.state = state
    overwrite trace.status_code = status_code
    overwrite trace.trace_name = trace_name
    overwrite trace.client_request_id = client_request_id
    overwrite trace.request_preview = request_preview
    overwrite trace.response_preview = response_preview
    overwrite trace.source_run_id = source_run_id
    overwrite trace.span_count = span_count
    overwrite trace.error_span_count = error_span_count
    overwrite trace.total_input_tokens = total_input_tokens
    overwrite trace.total_output_tokens = total_output_tokens
    overwrite trace.total_tokens = total_tokens
    overwrite trace.cache_read_input_tokens = cache_read_input_tokens
    overwrite trace.cache_creation_input_tokens = cache_creation_input_tokens
    overwrite trace.total_cost_micros = total_cost_micros
    overwrite trace.session_id = session_id
    overwrite trace.packed_trace_metadata = packed_trace_metadata
    overwrite trace.packed_tags = packed_tags
    overwrite trace.packed_run_ids = packed_run_ids
    overwrite trace.packed_prompt_versions = packed_prompt_versions
    overwrite trace.requested_at = requested_at
    overwrite trace.initialized = initialized
    return TraceUpserted { trace: trace }
  }

  bulk command IngestTraceSpans {
    input request_id: string<128>
    input experiment_id: u64
    input trace_id: string<64>
    input request_time_ms: i64
    input execution_duration_ms: i64
    input state: string<32>
    input status_code: string<32>
    input trace_name: string<256>
    input client_request_id: optional<string<128>>
    input request_preview: optional<string<2000>>
    input response_preview: optional<string<2000>>
    input source_run_id: optional<string<32>>
    input span_count: i64
    input error_span_count: i64
    input total_input_tokens: i64
    input total_output_tokens: i64
    input total_tokens: i64
    input cache_read_input_tokens: i64
    input cache_creation_input_tokens: i64
    input total_cost_micros: i64
    input session_id: optional<string<128>>
    input packed_trace_metadata: bytes<16384>
    input packed_tags: bytes<16384>
    input packed_run_ids: bytes<16384>
    input packed_prompt_versions: bytes<16384>
    input requested_at: timestamp
    input initialized: bool
    input spans: list<TraceSpan, 1..64> aggregate_bytes <= 1000000
    idempotency_key request_id
    init_or_mutate Trace(experiment_id, trace_id) as trace initialize {
      request_time_ms: request_time_ms,
      execution_duration_ms: execution_duration_ms,
      state: state,
      status_code: status_code,
      trace_name: trace_name,
      client_request_id: client_request_id,
      request_preview: request_preview,
      response_preview: response_preview,
      source_run_id: source_run_id,
      span_count: span_count,
      error_span_count: error_span_count,
      total_input_tokens: total_input_tokens,
      total_output_tokens: total_output_tokens,
      total_tokens: total_tokens,
      cache_read_input_tokens: cache_read_input_tokens,
      cache_creation_input_tokens: cache_creation_input_tokens,
      total_cost_micros: total_cost_micros,
      session_id: session_id,
      packed_trace_metadata: packed_trace_metadata,
      packed_tags: packed_tags,
      packed_run_ids: packed_run_ids,
      packed_prompt_versions: packed_prompt_versions,
      requested_at: requested_at,
      initialized: initialized,
    }
    for item in spans {
      init_or_mutate TraceSpan(experiment_id, trace_id, item.span_id) as span initialize {
        parent_id: item.parent_id,
        name: item.name,
        span_type: item.span_type,
        status: item.status,
        start_time_ns: item.start_time_ns,
        end_time_ns: item.end_time_ns,
        duration_ms: item.duration_ms,
        model_name: item.model_name,
        model_provider: item.model_provider,
        input_tokens: item.input_tokens,
        output_tokens: item.output_tokens,
        total_tokens: item.total_tokens,
        input_cost_micros: item.input_cost_micros,
        output_cost_micros: item.output_cost_micros,
        total_cost_micros: item.total_cost_micros,
        started_at: item.started_at,
        packed_span_json: item.packed_span_json,
      }
      overwrite span.parent_id = item.parent_id
      overwrite span.name = item.name
      overwrite span.span_type = item.span_type
      overwrite span.status = item.status
      overwrite span.start_time_ns = item.start_time_ns
      overwrite span.end_time_ns = item.end_time_ns
      overwrite span.duration_ms = item.duration_ms
      overwrite span.model_name = item.model_name
      overwrite span.model_provider = item.model_provider
      overwrite span.input_tokens = item.input_tokens
      overwrite span.output_tokens = item.output_tokens
      overwrite span.total_tokens = item.total_tokens
      overwrite span.input_cost_micros = item.input_cost_micros
      overwrite span.output_cost_micros = item.output_cost_micros
      overwrite span.total_cost_micros = item.total_cost_micros
      overwrite span.started_at = item.started_at
      overwrite span.packed_span_json = item.packed_span_json
      emit SpanObserved {
        experiment_id: experiment_id,
        span_type: item.span_type,
        model_name: item.model_name,
        status: item.status,
        duration_ms: item.duration_ms,
        input_tokens: item.input_tokens,
        output_tokens: item.output_tokens,
        total_tokens: item.total_tokens,
        cost_micros: item.total_cost_micros,
        observed_at: item.started_at,
      }
    }
    overwrite trace.request_time_ms = request_time_ms
    overwrite trace.execution_duration_ms = execution_duration_ms
    overwrite trace.state = state
    overwrite trace.status_code = status_code
    overwrite trace.trace_name = trace_name
    overwrite trace.client_request_id = client_request_id
    overwrite trace.request_preview = request_preview
    overwrite trace.response_preview = response_preview
    overwrite trace.source_run_id = source_run_id
    overwrite trace.span_count = span_count
    overwrite trace.error_span_count = error_span_count
    overwrite trace.total_input_tokens = total_input_tokens
    overwrite trace.total_output_tokens = total_output_tokens
    overwrite trace.total_tokens = total_tokens
    overwrite trace.cache_read_input_tokens = cache_read_input_tokens
    overwrite trace.cache_creation_input_tokens = cache_creation_input_tokens
    overwrite trace.total_cost_micros = total_cost_micros
    overwrite trace.session_id = session_id
    overwrite trace.packed_trace_metadata = packed_trace_metadata
    overwrite trace.packed_tags = packed_tags
    overwrite trace.packed_run_ids = packed_run_ids
    overwrite trace.packed_prompt_versions = packed_prompt_versions
    overwrite trace.requested_at = requested_at
    overwrite trace.initialized = initialized
    return TraceSpansIngested { trace: trace }
  }

  command DeleteTrace {
    input request_id: string<128>
    input experiment_id: u64
    input trace_id: string<64>
    idempotency_key request_id
    delete Trace(experiment_id, trace_id) as trace else TraceMissing {}
    return TraceDeleted { trace: trace }
  }

