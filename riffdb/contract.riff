contract RiffDBMLflow version 1 {
  enum LifecycleStage { Active, Deleted }
  enum RunStatus { Running, Scheduled, Finished, Failed, Killed }
  enum RunDataKind { Metric, LatestMetric, Param, Tag }
  enum ExperimentOrder {
    NameAscIdAsc,
    NameAscIdDesc,
    NameDescIdAsc,
    NameDescIdDesc,
    CreationAscIdAsc,
    CreationAscIdDesc,
    CreationDescIdAsc,
    CreationDescIdDesc,
    UpdateAscIdAsc,
    UpdateAscIdDesc,
    UpdateDescIdAsc,
    UpdateDescIdDesc,
    IdAsc,
    IdDesc
  }

  entity Experiment {
    key (scope: string<32>, experiment_id: u64)
    field name: string<500>
    field name_digest: bytes<32>
    field artifact_location: optional<string<8000>>
    field lifecycle_stage: LifecycleStage
    field creation_time: timestamp
    field last_update_time: timestamp
    field packed_tags: bytes<900000>
    field revision: u64
    unique by_name (scope, name)
    index by_id (scope, experiment_id)
    index by_name_digest (scope, name_digest, experiment_id)
    index by_lifecycle_update (scope, lifecycle_stage, last_update_time, experiment_id)
    index by_update (scope, last_update_time, experiment_id)
    index by_creation (scope, creation_time, experiment_id)
    pattern_index by_name_binary_pattern(
      name,
      profile binary_utf8_v1,
      operators (equals, starts_with, ends_with, contains, like, not_like),
      max_source_bytes 500,
      max_matched_bytes 500,
      max_rows 65535,
      max_total_matched_bytes 268435456,
      max_grams_per_row 500,
      max_distinct_grams 65535,
      max_postings 1048576,
      max_postings_bytes 67108864,
      max_pattern_bytes 500,
      max_pattern_atoms 500,
      max_candidates 65535,
      max_verification_bytes 268435456,
      max_results 65534,
      staleness_slo 60,
      replay_age_seconds 86400,
      replay_bytes 1073741824,
      replay_backlog 100000,
      retained_generations 8
    )
    pattern_index by_name_folded_pattern(
      name,
      profile unicode_fold_v1,
      operators (equals, starts_with, ends_with, contains, like, ilike, not_like, not_ilike),
      max_source_bytes 500,
      max_matched_bytes 9000,
      max_rows 65535,
      max_total_matched_bytes 268435456,
      max_grams_per_row 500,
      max_distinct_grams 65535,
      max_postings 1048576,
      max_postings_bytes 67108864,
      max_pattern_bytes 500,
      max_pattern_atoms 500,
      max_candidates 65535,
      max_verification_bytes 268435456,
      max_results 65534,
      staleness_slo 60,
      replay_age_seconds 86400,
      replay_bytes 1073741824,
      replay_backlog 100000,
      retained_generations 8
    )
  }

  entity ExperimentTag {
    key (scope: string<32>, experiment_id: u64, tag_key: string<250>)
    field value: string<5000>
    field value_digest: bytes<32>
    index by_tag_key (scope, tag_key, experiment_id)
    index by_tag_digest (scope, tag_key, value_digest, experiment_id)
    pattern_index by_value_binary_pattern(
      value,
      profile binary_utf8_v1,
      operators (equals, starts_with, ends_with, contains, like, not_like),
      max_source_bytes 5000,
      max_matched_bytes 5000,
      max_rows 65535,
      max_total_matched_bytes 268435456,
      max_grams_per_row 5000,
      max_distinct_grams 65535,
      max_postings 1048576,
      max_postings_bytes 67108864,
      max_pattern_bytes 5000,
      max_pattern_atoms 5000,
      max_candidates 65535,
      max_verification_bytes 268435456,
      max_results 65534,
      staleness_slo 60,
      replay_age_seconds 86400,
      replay_bytes 1073741824,
      replay_backlog 100000,
      retained_generations 8
    )
    pattern_index by_value_folded_pattern(
      value,
      profile unicode_fold_v1,
      operators (equals, starts_with, ends_with, contains, like, ilike, not_like, not_ilike),
      max_source_bytes 5000,
      max_matched_bytes 90000,
      max_rows 65535,
      max_total_matched_bytes 268435456,
      max_grams_per_row 5000,
      max_distinct_grams 65535,
      max_postings 1048576,
      max_postings_bytes 67108864,
      max_pattern_bytes 5000,
      max_pattern_atoms 5000,
      max_candidates 65535,
      max_verification_bytes 268435456,
      max_results 65534,
      staleness_slo 60,
      replay_age_seconds 86400,
      replay_bytes 1073741824,
      replay_backlog 100000,
      retained_generations 8
    )
    reference experiment (scope, experiment_id) -> Experiment(scope, experiment_id)
    delete_policy no_inbound
  }

  entity Run {
    key (experiment_id: u64, run_id: string<32>)
    field user_id: string<256>
    field status: RunStatus
    field start_time: i64
    field end_time: optional<i64>
    field lifecycle_stage: LifecycleStage
    field artifact_uri: string<8000>
    field run_name: string<250>
    field packed_tags: bytes<900000>
    field packed_params: bytes<700000>
    field packed_latest_metrics: bytes<400000>
    field revision: u64
    field initialized: bool
    index by_start (experiment_id, start_time, run_id)
    index by_lifecycle_start (experiment_id, lifecycle_stage, start_time, run_id)
    index by_name (experiment_id, run_name, run_id)
    index by_status (experiment_id, status, run_id)
  }

  entity RunDatum {
    key (
      experiment_id: u64,
      run_id: string<32>,
      kind: RunDataKind,
      item_key: string<283>,
      entry_id: string<64>
    )
    field logical_key: string<250>
    field latest_item_key: string<283>
    field sort_key: string<64>
    field latest_sort_key: string<64>
    field text_value: string<8000>
    field value_digest: bytes<32>
    field value_bits: u64
    field value_identity: u64
    field value_order: u64
    field metric_timestamp: i64
    field metric_step: i64
    field is_nan: bool
    field promote_latest: bool
    index by_run_data (
      experiment_id, kind, item_key, value_digest, sort_key, run_id, entry_id
    ) cover(logical_key, value_bits, metric_timestamp, metric_step, is_nan)
    reference run (experiment_id, run_id) -> Run(experiment_id, run_id)
    delete_policy no_inbound
  }

  aggregate Experiments {
    root Experiment
    child ExperimentTag
    partition_by scope
    conflict_key (scope, experiment_id)
  }

  aggregate Runs {
    root Run
    child RunDatum
    partition_by experiment_id
    conflict_key (experiment_id, run_id)
  }

  command CreateExperiment {
    input request_id: string<128>
    input experiment_id: u64
    input name: string<500>
    input name_digest: bytes<32>
    input artifact_location: optional<string<8000>>
    input packed_tags: bytes<900000>
    service now: transaction_time
    idempotency_key request_id
    create Experiment("global", experiment_id) as experiment else ExperimentExists {}
    set experiment.name = name
    set experiment.name_digest = name_digest
    set experiment.artifact_location = artifact_location
    set experiment.lifecycle_stage = LifecycleStage.Active
    set experiment.creation_time = now
    set experiment.last_update_time = now
    set experiment.packed_tags = packed_tags
    set experiment.revision = 0
    return ExperimentCreated { experiment: experiment }
  }

  bulk command CreateExperimentWithTags {
    input request_id: string<128>
    input experiment_id: u64
    input name: string<500>
    input name_digest: bytes<32>
    input artifact_location: optional<string<8000>>
    input packed_tags: bytes<900000>
    input tags: list<ExperimentTag, 1..128> aggregate_bytes <= 900000
    service now: transaction_time
    idempotency_key request_id
    create Experiment("global", experiment_id) as experiment else ExperimentExists {}
    for candidate in tags {
      create ExperimentTag("global", experiment_id, candidate.tag_key) as tag
        else ExperimentTagExists {}
      set tag.value = candidate.value
      set tag.value_digest = candidate.value_digest
    }
    set experiment.name = name
    set experiment.name_digest = name_digest
    set experiment.artifact_location = artifact_location
    set experiment.lifecycle_stage = LifecycleStage.Active
    set experiment.creation_time = now
    set experiment.last_update_time = now
    set experiment.packed_tags = packed_tags
    set experiment.revision = 0
    return ExperimentCreated { experiment: experiment }
  }

  command RenameExperiment {
    input request_id: string<128>
    input experiment_id: u64
    input name: string<500>
    input name_digest: bytes<32>
    service now: transaction_time
    idempotency_key request_id
    mutate Experiment("global", experiment_id) as experiment else ExperimentMissing {}
    overwrite experiment.name = name
    overwrite experiment.name_digest = name_digest
    overwrite experiment.last_update_time = now
    set experiment.revision = experiment.revision + 1
    return ExperimentRenamed { experiment: experiment }
  }

  command DeleteExperiment {
    input request_id: string<128>
    input experiment_id: u64
    service now: transaction_time
    idempotency_key request_id
    mutate Experiment("global", experiment_id) as experiment else ExperimentMissing {}
    overwrite experiment.lifecycle_stage = LifecycleStage.Deleted
    overwrite experiment.last_update_time = now
    set experiment.revision = experiment.revision + 1
    return ExperimentDeleted { experiment: experiment }
  }

  command RestoreExperiment {
    input request_id: string<128>
    input experiment_id: u64
    service now: transaction_time
    idempotency_key request_id
    mutate Experiment("global", experiment_id) as experiment else ExperimentMissing {}
    overwrite experiment.lifecycle_stage = LifecycleStage.Active
    overwrite experiment.last_update_time = now
    set experiment.revision = experiment.revision + 1
    return ExperimentRestored { experiment: experiment }
  }

  command SetExperimentTag {
    input request_id: string<128>
    input experiment_id: u64
    input tag_key: string<250>
    input value: string<5000>
    input value_digest: bytes<32>
    input packed_tags: bytes<900000>
    input expected_revision: u64
    service now: transaction_time
    idempotency_key request_id
    mutate Experiment("global", experiment_id) as experiment else ExperimentMissing {}
    init_or_mutate ExperimentTag("global", experiment_id, tag_key) as tag initialize {
      value: value,
      value_digest: value_digest,
    }
    require current_revision: experiment.revision == expected_revision else ExperimentStale {}
    require active: experiment.lifecycle_stage == LifecycleStage.Active else ExperimentInactive {}
    set tag.value = value
    set tag.value_digest = value_digest
    set experiment.packed_tags = packed_tags
    set experiment.last_update_time = now
    set experiment.revision = experiment.revision + 1
    return ExperimentTagSet { experiment: experiment }
  }

  command DeleteExperimentTag {
    input request_id: string<128>
    input experiment_id: u64
    input tag_key: string<250>
    input packed_tags: bytes<900000>
    input expected_revision: u64
    service now: transaction_time
    idempotency_key request_id
    mutate Experiment("global", experiment_id) as experiment else ExperimentMissing {}
    delete ExperimentTag("global", experiment_id, tag_key) as tag else ExperimentTagMissing {}
    require current_revision: experiment.revision == expected_revision else ExperimentStale {}
    require active: experiment.lifecycle_stage == LifecycleStage.Active else ExperimentInactive {}
    set experiment.packed_tags = packed_tags
    set experiment.last_update_time = now
    set experiment.revision = experiment.revision + 1
    return ExperimentTagDeleted { experiment: experiment }
  }

  command CreateRun {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    input user_id: string<256>
    input start_time: i64
    input artifact_uri: string<8000>
    input run_name: string<250>
    input packed_tags: bytes<900000>
    input packed_params: bytes<700000>
    input packed_latest_metrics: bytes<400000>
    idempotency_key request_id
    create Run(experiment_id, run_id) as run else RunExists {}
    set run.user_id = user_id
    set run.status = RunStatus.Running
    set run.start_time = start_time
    set run.end_time = null
    set run.lifecycle_stage = LifecycleStage.Active
    set run.artifact_uri = artifact_uri
    set run.run_name = run_name
    set run.packed_tags = packed_tags
    set run.packed_params = packed_params
    set run.packed_latest_metrics = packed_latest_metrics
    set run.revision = 0
    set run.initialized = true
    return RunCreated { run: run }
  }

  bulk command CreateRunWithTags {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    input user_id: string<256>
    input start_time: i64
    input artifact_uri: string<8000>
    input run_name: string<250>
    input packed_tags: bytes<900000>
    input packed_params: bytes<700000>
    input packed_latest_metrics: bytes<400000>
    input tags: list<RunDatum, 1..100> aggregate_bytes <= 900000
    idempotency_key request_id
    create Run(experiment_id, run_id) as run else RunExists {}
    for candidate in tags {
      create RunDatum(
        experiment_id,
        run_id,
        RunDataKind.Tag,
        candidate.item_key,
        ""
      ) as tag else RunTagExists {}
      set tag.logical_key = candidate.logical_key
      set tag.latest_item_key = candidate.latest_item_key
      set tag.sort_key = candidate.sort_key
      set tag.latest_sort_key = candidate.latest_sort_key
      set tag.text_value = candidate.text_value
      set tag.value_digest = candidate.value_digest
      set tag.value_bits = 0
      set tag.value_identity = 0
      set tag.value_order = 0
      set tag.metric_timestamp = 0
      set tag.metric_step = 0
      set tag.is_nan = false
      set tag.promote_latest = false
    }
    set run.user_id = user_id
    set run.status = RunStatus.Running
    set run.start_time = start_time
    set run.end_time = null
    set run.lifecycle_stage = LifecycleStage.Active
    set run.artifact_uri = artifact_uri
    set run.run_name = run_name
    set run.packed_tags = packed_tags
    set run.packed_params = packed_params
    set run.packed_latest_metrics = packed_latest_metrics
    set run.revision = 0
    set run.initialized = true
    return RunCreated { run: run }
  }

  command UpdateRunInfo {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    input status: RunStatus
    input end_time: optional<i64>
    input run_name: string<250>
    input run_name_tag_value: string<8000>
    input run_name_digest: bytes<32>
    input packed_tags: bytes<900000>
    input expected_revision: u64
    idempotency_key request_id
    mutate Run(experiment_id, run_id) as run else RunMissing {}
    init_or_mutate RunDatum(
      experiment_id,
      run_id,
      RunDataKind.Tag,
      "mlflow.runName",
      ""
    ) as run_name_tag initialize {
      logical_key: "mlflow.runName",
      latest_item_key: "mlflow.runName",
      sort_key: "",
      latest_sort_key: "",
      text_value: run_name_tag_value,
      value_digest: run_name_digest,
      value_bits: 0,
      value_identity: 0,
      value_order: 0,
      metric_timestamp: 0,
      metric_step: 0,
      is_nan: false,
      promote_latest: false,
    }
    require current_revision: run.revision == expected_revision else RunStale {}
    require active: run.lifecycle_stage == LifecycleStage.Active else RunInactive {}
    set run_name_tag.text_value = run_name_tag_value
    set run_name_tag.value_digest = run_name_digest
    set run.status = status
    set run.end_time = end_time
    set run.run_name = run_name
    set run.packed_tags = packed_tags
    set run.revision = run.revision + 1
    return RunUpdated { run: run }
  }

  bulk command LogBatch {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    input expected_revision: u64
    input packed_tags: bytes<900000>
    input packed_params: bytes<700000>
    input packed_latest_metrics: bytes<400000>
    input items: list<RunDatum, 1..1000> aggregate_bytes <= 1000000
    idempotency_key request_id
    observe_or_initialize Run(experiment_id, run_id) as run initialize {
      user_id: "",
      status: RunStatus.Running,
      start_time: 0,
      end_time: null,
      lifecycle_stage: LifecycleStage.Deleted,
      artifact_uri: "",
      run_name: "",
      packed_tags: packed_tags,
      packed_params: packed_params,
      packed_latest_metrics: packed_latest_metrics,
      revision: 0,
      initialized: false,
    }
    decide run {
      when run.initialized == false => reject RunMissing {}
      when run.revision != expected_revision => reject RunStale {}
      when run.lifecycle_stage != LifecycleStage.Active => reject RunInactive {}
      else => apply {
        overwrite run.packed_tags = packed_tags
        overwrite run.packed_params = packed_params
        overwrite run.packed_latest_metrics = packed_latest_metrics
        set run.revision = run.revision + 1
        overwrite run.initialized = true
      }
    }
    for candidate in items {
      observe_or_initialize RunDatum(
        experiment_id,
        run_id,
        candidate.kind,
        candidate.item_key,
        candidate.entry_id
      ) as stored initialize {
        logical_key: candidate.logical_key,
        latest_item_key: candidate.latest_item_key,
        sort_key: candidate.sort_key,
        latest_sort_key: candidate.latest_sort_key,
        text_value: candidate.text_value,
        value_digest: candidate.value_digest,
        value_bits: candidate.value_bits,
        value_identity: candidate.value_identity,
        value_order: candidate.value_order,
        metric_timestamp: candidate.metric_timestamp,
        metric_step: candidate.metric_step,
        is_nan: candidate.is_nan,
        promote_latest: candidate.promote_latest,
      }
      decide stored {
        when candidate.kind == RunDataKind.Param
          && stored.text_value != candidate.text_value
          => reject ParamConflict { param_key: candidate.logical_key }
        when candidate.kind == RunDataKind.Metric
          && candidate.promote_latest == true
          => apply {
            init_or_mutate RunDatum(
              experiment_id,
              run_id,
              RunDataKind.LatestMetric,
              candidate.latest_item_key,
              ""
            ) as latest initialize {
              logical_key: candidate.logical_key,
              latest_item_key: candidate.latest_item_key,
              sort_key: candidate.latest_sort_key,
              latest_sort_key: candidate.latest_sort_key,
              text_value: "",
              value_digest: candidate.value_digest,
              value_bits: candidate.value_bits,
              value_identity: candidate.value_identity,
              value_order: candidate.value_order,
              metric_timestamp: candidate.metric_timestamp,
              metric_step: candidate.metric_step,
              is_nan: candidate.is_nan,
              promote_latest: false,
            }
            overwrite stored.text_value = candidate.text_value
            overwrite stored.logical_key = candidate.logical_key
            overwrite stored.latest_item_key = candidate.latest_item_key
            overwrite stored.sort_key = candidate.sort_key
            overwrite stored.latest_sort_key = candidate.latest_sort_key
            overwrite stored.value_digest = candidate.value_digest
            overwrite stored.value_bits = candidate.value_bits
            overwrite stored.value_identity = candidate.value_identity
            overwrite stored.value_order = candidate.value_order
            overwrite stored.metric_timestamp = candidate.metric_timestamp
            overwrite stored.metric_step = candidate.metric_step
            overwrite stored.is_nan = candidate.is_nan
            overwrite stored.promote_latest = false
            overwrite latest.text_value = ""
            overwrite latest.logical_key = candidate.logical_key
            overwrite latest.latest_item_key = candidate.latest_item_key
            overwrite latest.sort_key = candidate.latest_sort_key
            overwrite latest.latest_sort_key = candidate.latest_sort_key
            overwrite latest.value_digest = candidate.value_digest
            overwrite latest.value_bits = candidate.value_bits
            overwrite latest.value_identity = candidate.value_identity
            overwrite latest.value_order = candidate.value_order
            overwrite latest.metric_timestamp = candidate.metric_timestamp
            overwrite latest.metric_step = candidate.metric_step
            overwrite latest.is_nan = candidate.is_nan
            overwrite latest.promote_latest = false
        }
        else => apply {
          overwrite stored.logical_key = candidate.logical_key
          overwrite stored.latest_item_key = candidate.latest_item_key
          overwrite stored.sort_key = candidate.sort_key
          overwrite stored.latest_sort_key = candidate.latest_sort_key
          overwrite stored.text_value = candidate.text_value
          overwrite stored.value_digest = candidate.value_digest
          overwrite stored.value_bits = candidate.value_bits
          overwrite stored.value_identity = candidate.value_identity
          overwrite stored.value_order = candidate.value_order
          overwrite stored.metric_timestamp = candidate.metric_timestamp
          overwrite stored.metric_step = candidate.metric_step
          overwrite stored.is_nan = candidate.is_nan
          overwrite stored.promote_latest = false
        }
      }
    }
    return BatchLogged { run: run }
  }

  command ValidateRunActive {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    idempotency_key request_id
    read Run(experiment_id, run_id) as run else RunMissing {}
    require active: run.lifecycle_stage == LifecycleStage.Active else RunInactive {}
    return RunActive {}
  }

  command DeleteRun {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    idempotency_key request_id
    mutate Run(experiment_id, run_id) as run else RunMissing {}
    overwrite run.lifecycle_stage = LifecycleStage.Deleted
    set run.revision = run.revision + 1
    return RunDeleted { run: run }
  }

  command RestoreRun {
    input request_id: string<128>
    input experiment_id: u64
    input run_id: string<32>
    idempotency_key request_id
    mutate Run(experiment_id, run_id) as run else RunMissing {}
    overwrite run.lifecycle_stage = LifecycleStage.Active
    set run.revision = run.revision + 1
    return RunRestored { run: run }
  }
}
