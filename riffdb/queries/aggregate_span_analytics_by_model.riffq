query AggregateSpanAnalyticsByModel(
    $experiment_id: TraceSpan.experiment_id,
    $start_at: TraceSpan.started_at,
    $end_at: TraceSpan.started_at,
) {
    source projected SpanAnalytics
    freshness causal inherit_session_commit true max_wait_ms 5000

    many spans from TraceSpan
        where experiment_id == $experiment_id
          && started_at >= $start_at
          && started_at < $end_at
        take 500

    aggregate by_model from spans {
        group by model_name, span_type, status, hour(started_at) as hour_bucket
        count() as span_count
        sum(duration_ms) as sum_duration_ms
        min(duration_ms) as min_duration_ms
        max(duration_ms) as max_duration_ms
        p50(duration_ms) as p50_duration_ms
        p95(duration_ms) as p95_duration_ms
        p99(duration_ms) as p99_duration_ms
        sum(total_tokens) as sum_total_tokens
        sum(total_cost_micros) as sum_total_cost_micros
        order by sum_total_tokens desc, model_name asc, span_type asc, status asc, hour_bucket asc
        take 64
    }

    return Found {
        by_model: by_model {
            model_name
            span_type
            status
            hour_bucket
            span_count
            sum_duration_ms
            min_duration_ms
            max_duration_ms
            p50_duration_ms
            p95_duration_ms
            p99_duration_ms
            sum_total_tokens
            sum_total_cost_micros
        }
    }
    outcomes Found
}
