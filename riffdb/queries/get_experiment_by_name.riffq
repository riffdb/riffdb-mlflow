query GetExperimentByName(
    $scope: Experiment.scope,
    $name: Experiment.name,
) {
    one experiment from Experiment
        where scope == $scope
          && name == $name
        else Missing

    return Found {
        experiment: experiment {
            experiment_id
            name
            artifact_location
            lifecycle_stage
            creation_time
            last_update_time
            packed_tags
            revision
        }
    }

    outcomes Found | Missing
}
