query ListGatewaySecrets(
    $scope: GatewaySecretEntity.scope,
    $limit: Limit<10> = 10,
    $after: Cursor?,
) {
    many secrets from GatewaySecretEntity
        where scope == $scope
        order by secret_id asc
        take $limit after $after
        else IntegrityFailure

    return Found {
        secrets: secrets {
            secret_id secret_name encrypted_value wrapped_dek masked_value_json
            kek_version provider auth_config_json created_at_ms last_updated_at_ms
            created_by last_updated_by
        }
    }
    outcomes Found | IntegrityFailure
}
