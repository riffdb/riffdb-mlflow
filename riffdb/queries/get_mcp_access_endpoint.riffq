query GetMCPAccessEndpoint(
    $scope: MCPAccessEndpointEntity.scope,
    $endpoint_id: MCPAccessEndpointEntity.endpoint_id,
) {
    one endpoint from MCPAccessEndpointEntity
        where scope == $scope
          && endpoint_id == $endpoint_id
        else Missing

    return Found {
        endpoint: endpoint {
            endpoint_id server_name url transport_type
            server_version server_alias
            created_by last_updated_by created_at_ms last_updated_at_ms
        }
    }
    outcomes Found | Missing
}
