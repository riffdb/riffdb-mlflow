query GetGatewayGuardrail(
    $scope: GatewayGuardrailEntity.scope,
    $guardrail_id: GatewayGuardrailEntity.guardrail_id,
) {
    one guardrail from GatewayGuardrailEntity
        where scope == $scope
          && guardrail_id == $guardrail_id
        else Missing

    return Found {
        guardrail: guardrail {
            guardrail_id name scorer_id scorer_version stage action
            action_endpoint_id created_at_ms last_updated_at_ms
            created_by last_updated_by
        }
    }
    outcomes Found | Missing
}
