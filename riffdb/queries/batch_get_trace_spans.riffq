query BatchGetTraceSpans(
    $experiment_id: TraceSpan.experiment_id,
    $trace_ids: Set<TraceSpan.trace_id>,
    $limit: Limit<500> = 500,
    $after: Cursor?,
) {
    many spans from TraceSpan
        where experiment_id == $experiment_id
          && trace_id in $trace_ids
        order by trace_id asc, start_time_ns asc, span_id asc
        take $limit after $after
        else IntegrityFailure

    return Found {
        spans: spans {
            trace_id packed_span_json
        }
    }
    outcomes Found | IntegrityFailure
}
